                {
                  "id": "5bd7100",
                  "elType": "widget",
                  "settings": {
                    "editor": "<p>Com a imatge clàssica de qualsevol casa, la gespa és una de les parts més importants de qualsevol jardí i la primera impressió. A part de l'estètica visual, la gespa serveix com un espai ideal perquè juguin els nens i les mascotes.</p>",
                    "text_color": "#111111",
                    "align": "left",
                    "typography_typography": "custom",
                    "typography_font_size": {
                      "unit": "px",
                      "size": 20,
                      "sizes": []
